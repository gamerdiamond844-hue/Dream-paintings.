# ========================================
# DREAM PAINTINGS - FRONTEND ENVIRONMENT
# ========================================
# Copy this file to .env.local and fill in your actual values

# API Base URL
# Development: http://localhost:5000/api
# Production: https://your-render-backend.onrender.com/api
VITE_API_URL=https://dream-paintings-backend.onrender.com/api

# Public App URL (for sharing, social media, etc.)
VITE_APP_URL=https://your-vercel-domain.vercel.app

# Optional: Razorpay Key (if using payment gateway)
VITE_RAZORPAY_KEY=your_razorpay_public_key
